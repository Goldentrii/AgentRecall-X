# deploy/hosted/.env — read by compose.yaml. Copy to .env (setup.sh writes AR_DOMAIN for you).
# An empty value means "unset" (the default applies, or the feature stays off). Never commit .env.

# Public host name; Caddy gets its certificate for it. Required.
AR_DOMAIN=recall.example.com

# Per-user limits (defaults shown; 0 = off). See docs/hosted-server.md "Operations".
#AR_SERVER_QUOTA_MB=100
#AR_SERVER_RATE_PER_MIN=120

# OAuth sign-in with GitHub / Google (deploy/hosted/oauth-setup.sh fills these in).
#AR_PUBLIC_URL=https://recall.example.com
#AR_OAUTH_GITHUB_CLIENT_ID=
#AR_OAUTH_GITHUB_CLIENT_SECRET=
#AR_OAUTH_GOOGLE_CLIENT_ID=
#AR_OAUTH_GOOGLE_CLIENT_SECRET=
# Sign-up: empty = invite-only, "open" = anyone. Extra redirect URI prefixes, comma-separated.
# Privacy policy link (https) shown on the sign-in page.
#AR_OAUTH_SIGNUP=
#AR_OAUTH_REDIRECT_ALLOW=
#AR_PRIVACY_URL=

# Error alerts to the owner's Telegram chat. Off unless BOTH are set.
# 1. In Telegram, message @BotFather: /newbot -> pick a name and a username ending in "bot".
#    BotFather answers with the token (<digits>:<letters>). Treat it like a password.
# 2. Send your new bot /start (or add it to a group), then read your chat id (groups are negative)
#    without leaving the token in shell or browser history:
#      read -rs TOKEN && curl -fsS "https://api.telegram.org/bot$TOKEN/getUpdates" | grep -o '"chat":{"id":-\?[0-9]*'; unset TOKEN
#    Keep this file private: sudo chmod 600 .env
# 3. Fill both in, apply with `docker compose up -d`, then check with
#    `sudo docker compose exec server agent-recall-server alert test`.
# At most one message per error kind per 10 minutes; messages carry counts, never user data.
#AR_ALERT_TELEGRAM_BOT_TOKEN=
#AR_ALERT_TELEGRAM_CHAT_ID=
